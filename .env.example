# Copy to .env and replace every change-me value before starting the stack.
FAREBEACON_ENV=development
FAREBEACON_API_TOKEN=change-me-use-at-least-32-random-characters
FAREBEACON_POSTGRES_PASSWORD=change-me-use-a-random-database-password
FAREBEACON_PORT=8000
FAREBEACON_LOG_LEVEL=INFO
FAREBEACON_CELERY_TASK_ALWAYS_EAGER=false
FAREBEACON_DEFAULT_ALERT_COOLDOWN_MINUTES=1440
# Set these three values only when Telegram delivery is enabled.
FAREBEACON_NOTIFICATION_BACKEND=disabled
FAREBEACON_TELEGRAM_BOT_TOKEN=
FAREBEACON_TELEGRAM_CHAT_ID=
FAREBEACON_TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TZ=America/Sao_Paulo
